{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "upgrade": {
    "notice": false,
    "auto": false
  },
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#D5AC45",
          "template": "{{ .UserName }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#FBF1C7",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": "  "
          },
          "template": " <#7C6F64>in</> {{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#8EC07C",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FABD2F{{ end }}",
            "{{ if gt .Ahead 0 }}#83A598{{ end }}",
            "{{ if gt .Behind 0 }}#FB4934{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "template": " <#7C6F64>on</> {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#7C6F64",
          "properties": { "threshold": 500, "style": "round" },
          "template": " <#7C6F64>took</> {{ .FormattedMs }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#665C54",
          "properties": { "time_format": "15:04:05" },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#D5AC45",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FB4934{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#665C54",
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "#665C54",
    "template": "❯❯ "
  }
}
