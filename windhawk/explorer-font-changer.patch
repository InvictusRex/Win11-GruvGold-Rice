+    // Selects the settings font into `hdc` for one draw call, then puts the caller's font
+    // back. Left selected, the next DrawText on the same DC would read the already-scaled
+    // font and scale it again (multi-line tooltips grew line by line), and the font would
+    // be deleted while still selected.
+    class scoped_font {
+    public:
+        explicit scoped_font(HDC hdc) : m_hdc(hdc) {
+            auto font = LOGFONTW { 0 };
+            GetObjectW(GetCurrentObject(hdc, OBJ_FONT), sizeof(font), &font);
+            change_font_in_struct(&font);
+            m_font = CreateFontIndirectW(&font);
+            m_old = SelectObject(hdc, m_font);
+        }
+        ~scoped_font() {
+            SelectObject(m_hdc, m_old);
+            DeleteObject(m_font);
+        }
