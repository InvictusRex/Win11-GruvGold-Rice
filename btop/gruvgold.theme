#  GruvGold - btop theme
#  Gruvbox Dark on a pure-black base with a gold accent.
#  Keep in sync with theme/palette.json.

# Main background. Empty would mean "use terminal default"; we want true black.
theme[main_bg]="#000000"

# Main text colour
theme[main_fg]="#fbf1c7"

# Title colour for boxes
theme[title]="#fbf1c7"

# Higlight colour for keyboard shortcuts
theme[hi_fg]="#d5ac45"

# Background colour of selected items
theme[selected_bg]="#16130d"

# Foreground colour of selected items
theme[selected_fg]="#d5ac45"

# Colour of inactive/disabled text
theme[inactive_fg]="#665c54"

# Colour of text appearing on top of graphs
theme[graph_text]="#bdae93"

# Background colour of meters
theme[meter_bg]="#282421"

# Misc colour for processes box
theme[proc_misc]="#8ec07c"

# Cpu box outline colour
theme[cpu_box]="#282421"

# Memory/disks box outline colour
theme[mem_box]="#282421"

# Net up/down box outline colour
theme[net_box]="#282421"

# Processes box outline colour
theme[proc_box]="#282421"

# Box divider line and small boxes line colour
theme[div_line]="#282421"

# Temperature graph: low -> high
theme[temp_start]="#8ec07c"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"

# CPU graph colours: low -> high
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#d5ac45"
theme[cpu_end]="#fe8019"

# Mem/Disk free meter
theme[free_start]="#665c54"
theme[free_mid]="#7c6f64"
theme[free_end]="#bdae93"

# Mem/Disk cached meter
theme[cached_start]="#458588"
theme[cached_mid]="#83a598"
theme[cached_end]="#8ec07c"

# Mem/Disk available meter
theme[available_start]="#d79921"
theme[available_mid]="#d5ac45"
theme[available_end]="#fabd2f"

# Mem/Disk used meter
theme[used_start]="#98971a"
theme[used_mid]="#b8bb26"
theme[used_end]="#fb4934"

# Download graph colours
theme[download_start]="#665c54"
theme[download_mid]="#83a598"
theme[download_end]="#8ec07c"

# Upload graph colours
theme[upload_start]="#665c54"
theme[upload_mid]="#d5ac45"
theme[upload_end]="#fabd2f"

# Process box colour gradient for threads, mem and cpu usage
theme[process_start]="#d5ac45"
theme[process_mid]="#fabd2f"
theme[process_end]="#fe8019"
